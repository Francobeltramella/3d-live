						"author":{
							"aboutMe":"Luxurious and decorative high quality performance fabrics. Fabric Library offers an extensive\r\nrange of on-trend fabrics suitable for interior furnishing, meeting the latest in environmental\r\nstandards.",
							"aboutMeUrl":"https://textures.twinbru.com/en/FabricLibrary?utm_source=blenderkit&utm_campaign=fabriclibrary",
							"avatar128":"/avatar-redirect/1bc0c310-666b-4f9f-b156-dbe05e919e20/128/",
